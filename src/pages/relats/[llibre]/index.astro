---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButton from '../../../components/ShareButton.astro';
import { getCollection } from 'astro:content';
import {
  getItemLabel,
  getItemReadingTime,
  getItemSlug,
  groupBooks,
  groupItemsBySection,
  isBlankPageType,
} from '../../../utils/books';

export async function getStaticPaths() {
  const allRelats = await getCollection('relats');
  const books = groupBooks(allRelats);

  return books.map((book) => ({
    params: { llibre: book.id },
    props: {
      llibreId: book.id,
      llibreTitol: book.titol,
      sinopsi: book.sinopsi,
      chapters: book.items,
      firstSlug: book.firstSlug,
      countLabel: book.countLabel,
      estat: book.estat,
      portada: book.portada,
    },
  }));
}

const { llibreId, llibreTitol, sinopsi, chapters, firstSlug, countLabel, estat, portada } = Astro.props;
const sectionBlocks = groupItemsBySection(chapters);
const hasSections = sectionBlocks.some((b) => b.seccio !== null);
---

<BaseLayout title={`${llibreTitol} — Índex de l'obra | Scriptum`} description={sinopsi}>
  <div
    id="book-index-container"
    data-book-id={llibreId}
    data-total-items={chapters.length}
    class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12"
  >
    <!-- Enllaç enrere -->
    <a href="/relats" class="text-xs font-sans font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1">
      <span>← Tornar a la biblioteca</span>
    </a>

    <!-- Capçalera del llibre -->
    <div class="p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col md:flex-row gap-8 items-start">
      {portada ? (
        <div class="w-full md:w-48 h-72 md:h-64 rounded-2xl overflow-hidden shrink-0 shadow-lg border border-[var(--border-color)] bg-[var(--bg-main)]">
          <img
            src={portada}
            alt={`Portada de ${llibreTitol}`}
            class="w-full h-full object-cover"
          />
        </div>
      ) : (
        <div class="w-full md:w-48 h-64 rounded-2xl bg-gradient-to-br from-stone-800 to-amber-950 p-6 text-white flex flex-col justify-between shrink-0 shadow-lg relative overflow-hidden">
          <span class="text-[10px] tracking-widest uppercase font-mono opacity-70">Scriptum</span>
          <h2 class="font-display font-bold text-2xl leading-tight">
            {llibreTitol}
          </h2>
          <span class="text-xs font-mono opacity-80 border-t border-white/20 pt-2">{countLabel}</span>
        </div>
      )}

      <div class="flex-1 space-y-4">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest font-semibold flex-wrap">
          <span class="text-[var(--accent)]">Llibre / Relat</span>
          <span class="text-[var(--text-muted)]">·</span>
          <span class={estat === 'acabat' ? 'text-emerald-700' : 'text-[var(--text-muted)]'}>
            {estat === 'acabat' ? '✓ Obra completa' : '📖 Obra en curs'}
          </span>
        </div>
        <h1 class="font-display font-bold text-3xl sm:text-4xl text-[var(--text-primary)]">
          {llibreTitol}
        </h1>
        <p class="font-serif text-base text-[var(--text-muted)] leading-relaxed">
          {sinopsi}
        </p>

        <div class="pt-4 flex items-center gap-3 flex-wrap">
          {chapters.length > 0 && (
            <a
              id="book-index-cta"
              href={`/relats/${llibreId}/${firstSlug}`}
              class="px-6 py-3 rounded-xl bg-[var(--accent)] text-white text-xs font-sans font-semibold hover:opacity-90 transition-opacity shadow-sm flex items-center gap-2"
            >
              <span id="book-index-cta-text">Començar lectura</span>
              <span id="book-index-cta-icon">📖</span>
            </a>
          )}
          <ShareButton
            title={`${llibreTitol} | Scriptum`}
            text={sinopsi}
            label="Compartir obra"
            className="px-4 py-3 rounded-xl"
          />
          <span
            id="book-index-progress"
            class="hidden text-xs font-mono text-[var(--text-muted)] px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-main)]"
          ></span>
        </div>
      </div>
    </div>

    <!-- Índex ordenat (amb suport per seccions i pàgines especials) -->
    <section class="space-y-8">
      <div class="border-b border-[var(--border-color)] pb-3">
        <h2 class="font-display font-bold text-2xl text-[var(--text-primary)]">
          {hasSections ? 'Índex de l\'obra' : 'Índex de Capítols'}
        </h2>
      </div>

      <div class="space-y-8">
        {sectionBlocks.map((block) => (
          <div class="space-y-3">
            {block.seccio && (
              <div class="pt-2 pb-1 border-b border-[var(--border-color)]/70">
                <h3 class="font-display font-bold text-xl text-[var(--accent)]">
                  {block.seccio}
                </h3>
              </div>
            )}

            <div class="space-y-3">
              {block.items.map((item) => {
                const itemSlug = getItemSlug(item);
                const label = getItemLabel(item);
                const isBlank = isBlankPageType(item.data.tipus);
                const readingTime = getItemReadingTime(item);

                return isBlank ? (
                  <a
                    data-chapter-row={itemSlug}
                    href={`/relats/${llibreId}/${itemSlug}`}
                    class="group px-5 py-3.5 rounded-2xl border border-dashed border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--accent)] transition-all flex items-center justify-between gap-4"
                  >
                    <div class="flex items-center gap-3 min-w-0 flex-wrap">
                      <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] shrink-0">
                        ❦ {label}
                      </span>
                      <span class="font-serif italic text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors truncate">
                        {item.data.title}
                      </span>
                      <span data-bookmark-badge class="hidden text-[10px] font-mono px-2 py-0.5 rounded-full bg-[var(--accent)]/15 text-[var(--accent)] font-semibold">
                        🔖 Punt de llibre
                      </span>
                      <span data-read-badge class="hidden text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 border border-emerald-600/20">
                        ✓ Llegit
                      </span>
                    </div>

                    <span class="text-xs font-sans font-medium text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors shrink-0">
                      Obrir →
                    </span>
                  </a>
                ) : (
                  <a
                    data-chapter-row={itemSlug}
                    href={`/relats/${llibreId}/${itemSlug}`}
                    class="group p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent)] transition-all flex items-center justify-between gap-4 shadow-2xs"
                  >
                    <div class="space-y-1">
                      <div class="flex items-center gap-2 text-xs font-mono text-[var(--accent)] flex-wrap">
                        <span>{label}</span>
                        {readingTime && (
                          <>
                            <span>·</span>
                            <span class="text-[var(--text-muted)]">{readingTime}</span>
                          </>
                        )}
                        <span data-bookmark-badge class="hidden text-[10px] px-2 py-0.5 rounded-full bg-[var(--accent)]/15 text-[var(--accent)] font-semibold">
                          🔖 Punt de llibre
                        </span>
                        <span data-read-badge class="hidden text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 border border-emerald-600/20">
                          ✓ Llegit
                        </span>
                      </div>
                      <h3 class="font-display font-bold text-lg text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
                        {item.data.title}
                      </h3>
                      {item.data.sinopsi && (
                        <p class="text-xs text-[var(--text-muted)] font-serif line-clamp-1">
                          {item.data.sinopsi}
                        </p>
                      )}
                    </div>

                    <span class="text-xs font-sans font-semibold text-[var(--accent)] group-hover:translate-x-1 transition-transform shrink-0">
                      Llegir →
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { getBookProgress } from '../../../utils/readingProgress';

  const container = document.getElementById('book-index-container');
  if (container) {
    const bookId = container.dataset.bookId || '';
    const total = parseInt(container.dataset.totalItems || '0', 10);
    const progress = bookId ? getBookProgress(bookId) : null;

    if (progress) {
      const cta = document.getElementById('book-index-cta') as HTMLAnchorElement | null;
      const ctaText = document.getElementById('book-index-cta-text');
      const ctaIcon = document.getElementById('book-index-cta-icon');
      const progressEl = document.getElementById('book-index-progress');

      if (cta && progress.lastSlug) {
        cta.href = `/relats/${bookId}/${progress.lastSlug}`;
        if (ctaText) {
          ctaText.textContent = progress.lastLabel
            ? `Continuar lectura · ${progress.lastLabel}`
            : 'Continuar lectura';
        }
        if (ctaIcon) ctaIcon.textContent = '🔖';
      }

      const readSet = new Set(progress.readSlugs || []);
      if (progressEl && readSet.size > 0 && total > 0) {
        progressEl.classList.remove('hidden');
        progressEl.textContent = `Progrés: ${readSet.size} de ${total} llegits`;
      }

      container.querySelectorAll<HTMLElement>('[data-chapter-row]').forEach((row) => {
        const slug = row.dataset.chapterRow || '';
        const bookmarkBadge = row.querySelector<HTMLElement>('[data-bookmark-badge]');
        const readBadge = row.querySelector<HTMLElement>('[data-read-badge]');

        if (slug && slug === progress.lastSlug && bookmarkBadge) {
          bookmarkBadge.classList.remove('hidden');
          row.classList.add('border-[var(--accent)]/60');
        }
        if (slug && readSet.has(slug) && readBadge) {
          readBadge.classList.remove('hidden');
        }
      });
    }
  }
</script>
