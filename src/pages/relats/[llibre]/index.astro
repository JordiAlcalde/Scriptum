---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  getItemLabel,
  getItemSlug,
  groupBooks,
  groupItemsBySection,
  isBlankPageType,
} from '../../../utils/books';

export async function getStaticPaths() {
  const allRelats = await getCollection('relats');
  const books = groupBooks(allRelats);

  return books.map((book) => ({
    params: { llibre: book.id },
    props: {
      llibreId: book.id,
      llibreTitol: book.titol,
      sinopsi: book.sinopsi,
      chapters: book.items,
      firstSlug: book.firstSlug,
      countLabel: book.countLabel,
    },
  }));
}

const { llibreId, llibreTitol, sinopsi, chapters, firstSlug, countLabel } = Astro.props;
const sectionBlocks = groupItemsBySection(chapters);
const hasSections = sectionBlocks.some((b) => b.seccio !== null);
---

<BaseLayout title={`${llibreTitol} — Índex de l'obra | Scriptum`} description={sinopsi}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12">
    <!-- Enllaç enrere -->
    <a href="/relats" class="text-xs font-sans font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1">
      <span>← Tornar a la biblioteca</span>
    </a>

    <!-- Capçalera del llibre -->
    <div class="p-8 rounded-3xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col md:flex-row gap-8 items-start">
      <div class="w-full md:w-48 h-64 rounded-2xl bg-gradient-to-br from-stone-800 to-amber-950 p-6 text-white flex flex-col justify-between shrink-0 shadow-lg relative overflow-hidden">
        <span class="text-[10px] tracking-widest uppercase font-mono opacity-70">Scriptum</span>
        <h2 class="font-display font-bold text-2xl leading-tight">
          {llibreTitol}
        </h2>
        <span class="text-xs font-mono opacity-80 border-t border-white/20 pt-2">{countLabel}</span>
      </div>

      <div class="flex-1 space-y-4">
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
          Llibre / Relat
        </span>
        <h1 class="font-display font-bold text-3xl sm:text-4xl text-[var(--text-primary)]">
          {llibreTitol}
        </h1>
        <p class="font-serif text-base text-[var(--text-muted)] leading-relaxed">
          {sinopsi}
        </p>

        <div class="pt-4 flex items-center gap-3">
          {chapters.length > 0 && (
            <a
              href={`/relats/${llibreId}/${firstSlug}`}
              class="px-6 py-3 rounded-xl bg-[var(--accent)] text-white text-xs font-sans font-semibold hover:opacity-90 transition-opacity shadow-sm flex items-center gap-2"
            >
              <span>Començar lectura</span>
              <span>📖</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Índex ordenat (amb suport per seccions i pàgines especials) -->
    <section class="space-y-8">
      <div class="border-b border-[var(--border-color)] pb-3">
        <h2 class="font-display font-bold text-2xl text-[var(--text-primary)]">
          {hasSections ? 'Índex de l\'obra' : 'Índex de Capítols'}
        </h2>
      </div>

      <div class="space-y-8">
        {sectionBlocks.map((block) => (
          <div class="space-y-3">
            {block.seccio && (
              <div class="pt-2 pb-1 border-b border-[var(--border-color)]/70">
                <h3 class="font-display font-bold text-xl text-[var(--accent)]">
                  {block.seccio}
                </h3>
              </div>
            )}

            <div class="space-y-3">
              {block.items.map((item) => {
                const itemSlug = getItemSlug(item);
                const label = getItemLabel(item);
                const isBlank = isBlankPageType(item.data.tipus);

                return isBlank ? (
                  <a
                    href={`/relats/${llibreId}/${itemSlug}`}
                    class="group px-5 py-3.5 rounded-2xl border border-dashed border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--accent)] transition-all flex items-center justify-between gap-4"
                  >
                    <div class="flex items-center gap-3 min-w-0">
                      <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] shrink-0">
                        ❦ {label}
                      </span>
                      <span class="font-serif italic text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors truncate">
                        {item.data.title}
                      </span>
                    </div>

                    <span class="text-xs font-sans font-medium text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors shrink-0">
                      Obrir →
                    </span>
                  </a>
                ) : (
                  <a
                    href={`/relats/${llibreId}/${itemSlug}`}
                    class="group p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent)] transition-all flex items-center justify-between gap-4 shadow-2xs"
                  >
                    <div class="space-y-1">
                      <div class="flex items-center gap-2 text-xs font-mono text-[var(--accent)]">
                        <span>{label}</span>
                        {item.data.tempsLectura && (
                          <>
                            <span>·</span>
                            <span class="text-[var(--text-muted)]">{item.data.tempsLectura}</span>
                          </>
                        )}
                      </div>
                      <h3 class="font-display font-bold text-lg text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
                        {item.data.title}
                      </h3>
                      {item.data.sinopsi && (
                        <p class="text-xs text-[var(--text-muted)] font-serif line-clamp-1">
                          {item.data.sinopsi}
                        </p>
                      )}
                    </div>

                    <span class="text-xs font-sans font-semibold text-[var(--accent)] group-hover:translate-x-1 transition-transform shrink-0">
                      Llegir →
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
