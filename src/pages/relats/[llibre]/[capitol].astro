---
import ReaderLayout from '../../../layouts/ReaderLayout.astro';
import { getCollection } from 'astro:content';
import { getItemLabel, getItemSlug, sortBookItems } from '../../../utils/books';

export async function getStaticPaths() {
  const allRelats = await getCollection('relats');
  const bookIds = Array.from(new Set(allRelats.map((r) => r.data.llibreId)));

  const paths = [];

  for (const bId of bookIds) {
    const items = sortBookItems(allRelats.filter((r) => r.data.llibreId === bId));

    items.forEach((item, idx) => {
      const itemSlug = getItemSlug(item);
      const prevItem = idx > 0 ? items[idx - 1] : null;
      const nextItem = idx < items.length - 1 ? items[idx + 1] : null;

      paths.push({
        params: { llibre: bId, capitol: itemSlug },
        props: {
          chapter: item,
          itemLabel: getItemLabel(item),
          prevChapter: prevItem
            ? {
                title: prevItem.data.title,
                slug: getItemSlug(prevItem),
                label: getItemLabel(prevItem),
              }
            : null,
          nextChapter: nextItem
            ? {
                title: nextItem.data.title,
                slug: getItemSlug(nextItem),
                label: getItemLabel(nextItem),
              }
            : null,
        },
      });
    });
  }

  return paths;
}

const { chapter, itemLabel, prevChapter, nextChapter } = Astro.props;
const { Content } = await chapter.render();
---

<ReaderLayout
  title={chapter.data.title}
  llibre={chapter.data.llibre}
  llibreId={chapter.data.llibreId}
  itemLabel={itemLabel}
  tipus={chapter.data.tipus}
  seccio={chapter.data.seccio}
  sinopsi={chapter.data.sinopsi}
  tempsLectura={chapter.data.tempsLectura}
  prevChapter={prevChapter}
  nextChapter={nextChapter}
>
  <Content />
</ReaderLayout>
