---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import TagFilterBar from '../../../components/TagFilterBar.astro';
import { getCollection } from 'astro:content';
import { getBlogTags, slugifyTag, type TagInfo } from '../../../utils/tags';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const allTags = await getBlogTags(sortedPosts);

  return allTags.map((tagInfo) => {
    const filteredPosts = sortedPosts.filter((post) =>
      (post.data.tags || []).some((t) => slugifyTag(t) === tagInfo.slug)
    );

    return {
      params: { tag: tagInfo.slug },
      props: {
        tagInfo,
        posts: filteredPosts,
        allTags,
        totalPosts: sortedPosts.length,
      },
    };
  });
}

interface Props {
  tagInfo: TagInfo;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
  allTags: TagInfo[];
  totalPosts: number;
}

const { tagInfo, posts, allTags, totalPosts } = Astro.props;
---

<BaseLayout
  title={`#${tagInfo.label} | Blog Scriptum`}
  description={tagInfo.description || `Articles etiquetats amb #${tagInfo.label} a Scriptum.`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-10">
    <header class="space-y-4 pb-8 border-b border-[var(--border-color)]">
      <div>
        <a
          href="/blog"
          class="text-xs font-sans font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1"
        >
          <span>← Tots els articles del blog</span>
        </a>
      </div>

      <div class="flex items-baseline gap-3 flex-wrap">
        <h1 class="font-display font-bold text-3xl sm:text-5xl text-[var(--text-primary)]">
          <span class="text-[var(--accent)]">#</span>{tagInfo.label}
        </h1>
        <span class="text-xs font-mono text-[var(--text-muted)]">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'}
        </span>
      </div>

      {tagInfo.description && (
        <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] max-w-2xl">
          <p class="font-serif text-base text-[var(--text-primary)] leading-relaxed">
            {tagInfo.description}
          </p>
        </div>
      )}
    </header>

    <TagFilterBar tags={allTags} totalPosts={totalPosts} activeTag={tagInfo.slug} />

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard
          slug={post.slug}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          image={post.data.image}
        />
      ))}
    </div>
  </div>
</BaseLayout>
