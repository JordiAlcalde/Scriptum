---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getCollection } from 'astro:content';
import { estimateReadingTime } from '../../utils/readingTime';
import { isVisibleEntry } from '../../utils/drafts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', isVisibleEntry);
  const sortedPosts = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return sortedPosts.map((post, idx) => {
    const newerPost = idx > 0 ? sortedPosts[idx - 1] : null;
    const olderPost = idx < sortedPosts.length - 1 ? sortedPosts[idx + 1] : null;

    return {
      params: { slug: post.slug },
      props: {
        post,
        prevPost: olderPost ? { title: olderPost.data.title, slug: olderPost.slug } : null,
        nextPost: newerPost ? { title: newerPost.data.title, slug: newerPost.slug } : null,
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await post.render();
---

<BlogPostLayout
  slug={post.slug}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  author={post.data.author}
  tags={post.data.tags}
  headings={headings}
  readingTime={estimateReadingTime(post.body)}
  idioma={post.data.idioma}
  esborrany={post.data.esborrany}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPostLayout>

