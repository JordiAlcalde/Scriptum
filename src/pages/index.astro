---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { groupBooks } from '../utils/books';
import { estimateReadingTime } from '../utils/readingTime';
import { isVisibleEntry } from '../utils/drafts';

// Obtenir relats i agrupar per llibre (filtrant esborranys en producció)
const allRelats = await getCollection('relats', isVisibleEntry);
const allPosts = await getCollection('blog', isVisibleEntry);

const allBooks = groupBooks(allRelats);
const recentBooks = allBooks.slice(0, 3);
const recentPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout>
  <!-- HERO PRINCIPAL EDITORIAL -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-20 text-center space-y-6">
    <h1 class="font-display font-bold text-4xl sm:text-6xl text-[var(--text-primary)] tracking-tight max-w-3xl mx-auto leading-tight">
      L'espai on les paraules recuperen el seu temps.
    </h1>

    <p class="font-serif text-lg sm:text-xl text-[var(--text-muted)] max-w-2xl mx-auto leading-relaxed">
      Novel·les i relats per capítols, pensaments literaris i lectures reposades en un entorn dissenyat per gaudir de cada paràgraf.
    </p>

    <div class="pt-4 flex items-center justify-center gap-4 flex-wrap">
      <a
        href="/relats"
        class="px-6 py-3 rounded-xl bg-[var(--accent)] hover:opacity-90 text-white font-sans text-sm font-semibold transition-all shadow-sm flex items-center gap-2 cursor-pointer"
      >
        <span>Explorar les obres</span>
        <span>→</span>
      </a>

      <a
        href="/blog"
        class="px-6 py-3 rounded-xl border border-[var(--border-color)] hover:bg-[var(--card-bg)] text-[var(--text-primary)] font-sans text-sm font-semibold transition-all cursor-pointer"
      >
        Llegir el blog
      </a>
    </div>
  </section>

  <!-- SECCIÓ DE RELATS I LLIBRES PER CAPÍTOLS -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 border-t border-[var(--border-color)] space-y-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs uppercase font-mono tracking-widest text-[var(--accent)] font-semibold">
          Literatura per lliuraments
        </span>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-[var(--text-primary)] mt-1">
          Llibres i relats
        </h2>
      </div>

      <a
        href="/relats"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent)] text-xs font-sans font-semibold text-[var(--text-primary)] hover:text-[var(--accent)] transition-all shadow-2xs shrink-0"
      >
        <span>Visitar tota la biblioteca ({allBooks.length} obres)</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6">
      {recentBooks.map((book) => (
        <BookCard
          llibreId={book.id}
          titol={book.titol}
          sinopsi={book.sinopsi}
          totalCapitols={book.readingCount}
          countLabel={book.countLabel}
          firstSlug={book.firstSlug}
          estat={book.estat}
          dateSummary={book.dateSummary}
          anyPublicacio={book.anyPublicacio}
          idioma={book.idioma}
          portada={book.portada}
        />
      ))}
    </div>
  </section>

  <!-- SECCIÓ ÚLTIMS ARTICLES DEL BLOG -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 border-t border-[var(--border-color)] space-y-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs uppercase font-mono tracking-widest text-[var(--accent)] font-semibold">
          Apunts & Cròniques
        </span>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-[var(--text-primary)] mt-1">
          Darreres entrades del Blog
        </h2>
      </div>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent)] text-xs font-sans font-semibold text-[var(--text-primary)] hover:text-[var(--accent)] transition-all shadow-2xs shrink-0"
      >
        <span>Tots els articles ({allPosts.length})</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <PostCard
          slug={post.slug}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          image={post.data.image}
          readingTime={estimateReadingTime(post.body)}
          idioma={post.data.idioma}
          esborrany={post.data.esborrany}
        />
      ))}
    </div>
  </section>

  <!-- DESPLEGABLE INFORMATIU: TOT EL QUE SCRIPTUM AMAGA -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-8">
    <details class="group rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] shadow-2xs transition-all">
      <summary class="list-none cursor-pointer px-6 py-5 flex items-center justify-between gap-4 select-none">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-8 h-8 rounded-lg bg-[var(--accent)]/12 text-[var(--accent)] flex items-center justify-center text-sm shrink-0">
            ✦
          </span>
          <div class="min-w-0">
            <span class="block font-display font-bold text-base sm:text-lg text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
              Entra aquí per descobrir tot el que Scriptum amaga
            </span>
            <span class="block text-xs font-serif text-[var(--text-muted)]">
              Petites comoditats pensades per fer-te la lectura més agradable, al teu ritme i sense registres.
            </span>
          </div>
        </div>

        <svg
          class="w-5 h-5 text-[var(--text-muted)] group-hover:text-[var(--accent)] group-open:rotate-180 transition-transform duration-200 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </summary>

      <div class="px-6 pb-6 pt-2 border-t border-[var(--border-color)]/70">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span>📜</span>
              <span>Tres tons de lectura</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Canvia quan vulguis entre <strong>Paper</strong>, <strong>Sèpia</strong> i <strong>Nocturn</strong> des de la barra superior o dins del lector.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span class="font-mono text-xs text-[var(--accent)]">A−/A+</span>
              <span>Mida de lletra ajustable</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Dins de cada llibre pots ampliar o reduir la mida del text perquè llegir en pantalla no cansi mai la vista.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span>🔖</span>
              <span>Punt de llibre i control de lectura</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Scriptum recorda automàticament en quin capítol ho vas deixar i marca amb <strong>✓ Llegit</strong> el que ja has acabat, directament al teu navegador.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span class="text-[var(--accent)]">✦</span>
              <span>Avís automàtic de novetats</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Quan tornis al web, t'avisarà dels nous articles, llibres o capítols afegits des de la teva darrera visita —fins i tot textos antics recuperats.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span>🌐</span>
              <span>Traducció opcional (CA · ES · EN)</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Pots traduir el web al castellà o a l'anglès des del selector superior, respectant sempre intactes els textos escrits originalment en aquests idiomes.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span>🏷️</span>
              <span>Etiquetes i ordenació</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Al blog pots filtrar els articles per etiquetes (cadascuna amb la seva definició) i a la biblioteca pots ordenar les obres per data o per títol.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span>⏱️</span>
              <span>Temps de lectura, índexs i notes</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Cada text indica els minuts estimats de lectura; els articles llargs inclouen índex d'apartats i notes al peu clicables amb enllaços de referència.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-[var(--border-color)]/70 bg-[var(--bg-main)] space-y-1">
            <h3 class="font-display font-bold text-sm text-[var(--text-primary)] flex items-center gap-2">
              <span>🔗</span>
              <span>Compartir i lectura sense rastreig</span>
            </h3>
            <p class="text-xs font-serif text-[var(--text-muted)] leading-relaxed">
              Comparteix qualsevol obra o article en un clic, en un espai tranquil sense anuncis, sense comptes d'usuari ni galetes invasives.
            </p>
          </div>
        </div>
      </div>
    </details>
  </section>
</BaseLayout>

