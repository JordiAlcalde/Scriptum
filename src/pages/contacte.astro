---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacte | Scriptum" description="Posa't en contacte amb l'autor de Scriptum.">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-8">
    <header class="space-y-3 pb-6 border-b border-[var(--border-color)]">
      <span class="text-xs uppercase font-mono tracking-widest text-[var(--accent)] font-semibold">
        Bústia de Correspondència
      </span>
      <h1 class="font-display font-bold text-3xl sm:text-4xl text-[var(--text-primary)]">
        Contacte
      </h1>
      <p class="font-serif text-base text-[var(--text-muted)] leading-relaxed">
        Tens una impressió sobre alguna de les obres, una proposta editorial o simplement vols saludar? Fes-me arribar les teves lletres.
      </p>
    </header>

    <!-- Avís de confirmació després d'enviar -->
    <div
      id="contact-success-banner"
      class="hidden p-5 rounded-2xl border border-emerald-600/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 font-sans text-sm space-y-1"
    >
      <p class="font-semibold">✓ Missatge enviat correctament!</p>
      <p class="text-xs opacity-90">Gràcies per escriure'm. Et respondré tan aviat com pugui.</p>
    </div>

    <form
      action="https://formsubmit.co/noufutur2001@gmail.com"
      method="POST"
      class="space-y-4 font-sans text-xs bg-[var(--card-bg)] p-6 sm:p-8 rounded-3xl border border-[var(--border-color)] shadow-xs"
    >
      <!-- Configuració FormSubmit -->
      <input type="hidden" name="_subject" value="Nou missatge des de Scriptum" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value="https://scriptum.minimmon.cat/contacte?enviat=1" />
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="nom" class="block font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-1">
          Nom o Àlies *
        </label>
        <input
          type="text"
          id="nom"
          name="Nom"
          required
          placeholder="El teu nom..."
          class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--text-primary)] outline-none focus:border-[var(--accent)] text-sm"
        />
      </div>

      <div>
        <label for="email" class="block font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-1">
          Adreça electrònica *
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="nom@exemple.cat"
          class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--text-primary)] outline-none focus:border-[var(--accent)] text-sm font-mono"
        />
      </div>

      <div>
        <label for="assumpte" class="block font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-1">
          Motiu o Obra de referència
        </label>
        <input
          type="text"
          id="assumpte"
          name="Assumpte"
          placeholder="Ex: Sobre 'Cròniques del silenci', comentari general..."
          class="w-full px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--text-primary)] outline-none focus:border-[var(--accent)] text-sm"
        />
      </div>

      <div>
        <label for="missatge" class="block font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-1">
          Missatge *
        </label>
        <textarea
          id="missatge"
          name="Missatge"
          rows="5"
          required
          placeholder="Escriu aquí les teves paraules..."
          class="w-full px-4 py-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--text-primary)] outline-none focus:border-[var(--accent)] text-sm font-serif leading-relaxed"
        ></textarea>
      </div>

      <div class="pt-2 flex items-center justify-between gap-4 flex-wrap">
        <span class="text-[11px] text-[var(--text-muted)]">
          * Les teves dades no es compartiran mai.
        </span>

        <button
          type="submit"
          class="px-6 py-3 rounded-xl bg-[var(--accent)] hover:opacity-90 text-white font-semibold transition-opacity shadow-xs cursor-pointer flex items-center gap-1.5"
        >
          <span>Enviar missatge</span>
          <span>✉️</span>
        </button>
      </div>
    </form>
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  if (params.get('enviat') === '1') {
    document.getElementById('contact-success-banner')?.classList.remove('hidden');
  }
</script>
