---
interface Props {
  llibreId: string;
  titol: string;
  sinopsi: string;
  totalCapitols: number;
  countLabel?: string;
  firstSlug?: string;
  estat?: 'en-curs' | 'acabat';
  dateSummary?: string;
  portada?: string;
  anyPublicacio?: string;
  portadaColor?: string;
}

const {
  llibreId,
  titol,
  sinopsi,
  totalCapitols,
  countLabel = `${totalCapitols} capítols`,
  firstSlug = 'capitol-01',
  estat = 'en-curs',
  dateSummary = '',
  portada,
  anyPublicacio = '2026',
  portadaColor = 'from-stone-700 to-amber-900',
} = Astro.props;
---

<article
  data-book-card={llibreId}
  data-total-items={totalCapitols}
  class="group bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col md:flex-row gap-5 p-5"
>
  <!-- Portada del llibre (imatge real o maqueta editorial per defecte) -->
  {portada ? (
    <a
      href={`/relats/${llibreId}`}
      class="block w-full md:w-36 h-56 md:h-48 rounded-xl overflow-hidden shrink-0 shadow-md border border-[var(--border-color)] bg-[var(--bg-main)] group-hover:scale-102 transition-transform duration-300"
    >
      <img
        src={portada}
        alt={`Portada de ${titol}`}
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </a>
  ) : (
    <div class={`w-full md:w-36 h-48 rounded-xl bg-gradient-to-br ${portadaColor} p-4 text-white flex flex-col justify-between shrink-0 shadow-md group-hover:scale-102 transition-transform duration-300 relative overflow-hidden`}>
      <div class="absolute inset-0 bg-black/15 pointer-events-none"></div>
      <span class="text-[10px] tracking-widest uppercase font-mono opacity-75">Scriptum Editorial</span>
      <h3 class="font-display font-bold text-lg leading-tight line-clamp-3">
        {titol}
      </h3>
      <div class="flex items-center justify-between text-[10px] font-mono opacity-80 border-t border-white/20 pt-2">
        <span>{countLabel}</span>
        <span>{anyPublicacio}</span>
      </div>
    </div>
  )}

  <!-- Contingut descriptiu i botons -->
  <div class="flex-1 flex flex-col justify-between space-y-3">
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider flex-wrap">
        <span class={estat === 'acabat' ? 'text-emerald-700 dark:text-emerald-400' : 'text-[var(--accent)]'}>
          {estat === 'acabat' ? '✓ Obra completa' : '📖 Obra en curs'}
        </span>
        <span class="text-[var(--text-muted)]">·</span>
        <span class="text-[var(--text-muted)] font-normal">{countLabel}</span>
        <span
          data-book-progress-badge
          class="hidden text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 border border-emerald-600/20 font-medium normal-case tracking-normal"
        ></span>
      </div>

      <h2 class="font-display font-bold text-xl text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
        <a href={`/relats/${llibreId}`}>
          {titol}
        </a>
      </h2>

      <p class="text-sm text-[var(--text-muted)] line-clamp-3 leading-relaxed font-serif">
        {sinopsi}
      </p>

      {dateSummary && (
        <p class="text-[11px] font-mono text-[var(--text-muted)] pt-0.5">
          📅 {dateSummary}
        </p>
      )}
    </div>

    <div class="pt-2 flex items-center justify-between gap-3 border-t border-[var(--border-color)]">
      <a
        href={`/relats/${llibreId}`}
        class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[var(--accent)] hover:underline"
      >
        <span>Veure índex de capítols</span>
        <span>→</span>
      </a>

      <a
        data-book-cta
        href={`/relats/${llibreId}/${firstSlug}`}
        class="px-4 py-2 rounded-xl bg-[var(--accent)] hover:opacity-90 text-white text-xs font-sans font-semibold transition-all shadow-xs cursor-pointer flex items-center gap-1.5"
      >
        <span data-book-cta-text>Començar lectura</span>
        <span data-book-cta-icon>📖</span>
      </a>
    </div>
  </div>
</article>

<script>
  import { getBookProgress } from '../utils/readingProgress';

  document.querySelectorAll<HTMLElement>('[data-book-card]').forEach((card) => {
    const bookId = card.dataset.bookCard;
    if (!bookId) return;

    const progress = getBookProgress(bookId);
    if (!progress) return;

    const cta = card.querySelector<HTMLAnchorElement>('[data-book-cta]');
    const ctaText = card.querySelector<HTMLElement>('[data-book-cta-text]');
    const ctaIcon = card.querySelector<HTMLElement>('[data-book-cta-icon]');
    const badge = card.querySelector<HTMLElement>('[data-book-progress-badge]');

    if (cta && progress.lastSlug) {
      cta.href = `/relats/${bookId}/${progress.lastSlug}`;
      if (ctaText) {
        ctaText.textContent = progress.lastLabel
          ? `Continuar · ${progress.lastLabel}`
          : 'Continuar lectura';
      }
      if (ctaIcon) ctaIcon.textContent = '🔖';
    }

    const total = parseInt(card.dataset.totalItems || '0', 10);
    const readCount = progress.readSlugs?.length || 0;
    if (badge && readCount > 0) {
      badge.classList.remove('hidden');
      if (total > 0 && readCount >= total) {
        badge.textContent = '✓ Llegit';
      } else if (total > 0) {
        badge.textContent = `Llegits: ${readCount}/${total}`;
      } else {
        badge.textContent = `${readCount} llegits`;
      }
    }
  });
</script>

