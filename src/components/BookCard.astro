---
interface Props {
  llibreId: string;
  titol: string;
  sinopsi: string;
  totalCapitols: number;
  countLabel?: string;
  firstSlug?: string;
  estat?: 'en-curs' | 'acabat';
  anyPublicacio?: string;
  portadaColor?: string;
}

const {
  llibreId,
  titol,
  sinopsi,
  totalCapitols,
  countLabel = `${totalCapitols} capítols`,
  firstSlug = 'capitol-01',
  estat = 'en-curs',
  anyPublicacio = '2026',
  portadaColor = 'from-stone-700 to-amber-900',
} = Astro.props;
---

<article class="group bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col md:flex-row gap-5 p-5">
  <!-- Maqueta visual d'estil portada de llibre editorial -->
  <div class={`w-full md:w-36 h-48 rounded-xl bg-gradient-to-br ${portadaColor} p-4 text-white flex flex-col justify-between shrink-0 shadow-md group-hover:scale-102 transition-transform duration-300 relative overflow-hidden`}>
    <div class="absolute inset-0 bg-black/15 pointer-events-none"></div>
    <span class="text-[10px] tracking-widest uppercase font-mono opacity-75">Scriptum Editorial</span>
    <h3 class="font-display font-bold text-lg leading-tight line-clamp-3">
      {titol}
    </h3>
    <div class="flex items-center justify-between text-[10px] font-mono opacity-80 border-t border-white/20 pt-2">
      <span>{countLabel}</span>
      <span>{anyPublicacio}</span>
    </div>
  </div>

  <!-- Contingut descriptiu i botons -->
  <div class="flex-1 flex flex-col justify-between space-y-3">
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider">
        <span class={estat === 'acabat' ? 'text-emerald-700 dark:text-emerald-400' : 'text-[var(--accent)]'}>
          {estat === 'acabat' ? '✓ Obra completa' : '📖 Obra en curs'}
        </span>
        <span class="text-[var(--text-muted)]">·</span>
        <span class="text-[var(--text-muted)] font-normal">{countLabel}</span>
      </div>

      <h2 class="font-display font-bold text-xl text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
        <a href={`/relats/${llibreId}`}>
          {titol}
        </a>
      </h2>

      <p class="text-sm text-[var(--text-muted)] line-clamp-3 leading-relaxed font-serif">
        {sinopsi}
      </p>
    </div>

    <div class="pt-2 flex items-center justify-between gap-3 border-t border-[var(--border-color)]">
      <a
        href={`/relats/${llibreId}`}
        class="inline-flex items-center gap-2 text-xs font-sans font-semibold text-[var(--accent)] hover:underline"
      >
        <span>Veure índex de capítols</span>
        <span>→</span>
      </a>

      <a
        href={`/relats/${llibreId}/${firstSlug}`}
        class="px-4 py-2 rounded-xl bg-[var(--accent)] hover:opacity-90 text-white text-xs font-sans font-semibold transition-all shadow-xs cursor-pointer flex items-center gap-1.5"
      >
        <span>Començar lectura</span>
        <span>📖</span>
      </a>
    </div>
  </div>
</article>

