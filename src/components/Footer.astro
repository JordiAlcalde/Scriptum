---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[var(--border-color)] bg-[var(--card-bg)]/50 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-[var(--text-muted)] font-sans">
    <div class="flex items-center gap-3">
      <span class="w-6 h-6 rounded bg-[var(--accent)] text-white flex items-center justify-center font-display font-bold text-xs">
        S
      </span>
      <p class="font-display font-medium text-sm text-[var(--text-primary)]">
        Scriptum
      </p>
      <span>—</span>
      <p>Espai de relats, lectura pausada i pensament.</p>
    </div>

    <div class="flex items-center gap-3 sm:gap-4 flex-wrap justify-center">
      <a href="/relats" class="hover:text-[var(--accent)] transition-colors">Llibres i relats</a>
      <span>·</span>
      <a href="/blog" class="hover:text-[var(--accent)] transition-colors">Blog</a>
      <span>·</span>
      <a href="/contacte" class="hover:text-[var(--accent)] transition-colors">Contacte</a>
      <span>·</span>
      <a href="/avis-legal" class="hover:text-[var(--accent)] transition-colors">Avís legal i drets</a>
      <span>·</span>
      <span>© {currentYear} Jordi Alcalde</span>
    </div>
  </div>
</footer>

