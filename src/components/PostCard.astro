---
import { slugifyTag } from '../utils/tags';
import { getLangBadge } from '../utils/lang';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  image?: string;
  readingTime?: string;
  idioma?: string;
  esborrany?: boolean;
}

const { slug, title, description, pubDate, tags = [], image, readingTime = '4 min', idioma, esborrany = false } = Astro.props;
const langBadge = getLangBadge(idioma);

const formattedDate = new Intl.DateTimeFormat('ca-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(pubDate);
---

<article
  data-post-card={slug}
  class="group bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl p-6 shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between space-y-4"
>
  <div class="space-y-3">
    {image && (
      <a
        href={`/blog/${slug}`}
        class="block aspect-[16/9] w-full overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--bg-main)]"
      >
        <img
          src={image}
          alt={title}
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </a>
    )}

    <div class="flex items-center justify-between gap-2 text-xs font-mono text-[var(--text-muted)]">
      <time datetime={pubDate.toISOString()} class="whitespace-nowrap">{formattedDate}</time>
      <span class="whitespace-nowrap">{readingTime} de lectura</span>
    </div>

    {esborrany && (
      <div>
        <span class="inline-flex items-center gap-1 text-[10px] font-mono px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-700 border border-amber-600/30 font-semibold">
          📝 Esborrany
        </span>
      </div>
    )}

    <div data-original-lang={langBadge?.lang} class="space-y-3">
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-display font-bold text-xl text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
          <a href={`/blog/${slug}`}>
            {title}
          </a>
        </h3>
        {langBadge && (
          <span
            title={langBadge.title}
            class="notranslate shrink-0 mt-1 text-[10px] font-mono font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-[var(--accent)] text-white shadow-2xs"
          >
            {langBadge.code}
          </span>
        )}
      </div>

      <p class="text-sm text-[var(--text-muted)] line-clamp-3 leading-relaxed font-serif">
        {description}
      </p>
    </div>
  </div>

  <div class="pt-3 border-t border-[var(--border-color)] flex items-center justify-between gap-2">
    <div class="flex items-center gap-1.5 flex-wrap">
      {tags.map((tag) => (
        <a
          href={`/blog/etiqueta/${slugifyTag(tag)}`}
          class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-[var(--border-color)]/50 text-[var(--text-muted)] hover:bg-[var(--accent)]/15 hover:text-[var(--accent)] transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>

    <a
      data-post-cta
      href={`/blog/${slug}`}
      class="text-xs font-sans font-semibold text-[var(--accent)] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 shrink-0"
    >
      <span data-post-cta-text>Llegir</span>
      <span>→</span>
    </a>
  </div>
</article>

<script>
  import { isBlogPostRead } from '../utils/readingProgress';

  document.querySelectorAll<HTMLElement>('[data-post-card]').forEach((card) => {
    const slug = card.dataset.postCard;
    if (!slug) return;
    if (isBlogPostRead(slug)) {
      const cta = card.querySelector<HTMLElement>('[data-post-cta]');
      const ctaText = card.querySelector<HTMLElement>('[data-post-cta-text]');
      if (ctaText) ctaText.textContent = '✓ Llegit';
      cta?.classList.remove('text-[var(--accent)]');
      cta?.classList.add('text-emerald-700');
    }
  });
</script>

