---
import type { TagInfo } from '../utils/tags';

interface Props {
  tags: TagInfo[];
  totalPosts: number;
  activeTag?: string;
}

const { tags, totalPosts, activeTag } = Astro.props;
---

{tags.length > 0 && (
  <nav aria-label="Filtrar articles per etiqueta" class="space-y-3">
    <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--text-muted)]">
      <span>Filtrar per etiqueta</span>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <a
        href="/blog"
        class={`inline-flex items-center gap-1.5 text-xs font-mono px-3 py-1.5 rounded-full border transition-all ${
          !activeTag
            ? 'bg-[var(--accent)] text-white border-[var(--accent)] font-semibold shadow-xs'
            : 'bg-[var(--card-bg)] text-[var(--text-muted)] border-[var(--border-color)] hover:border-[var(--accent)] hover:text-[var(--accent)]'
        }`}
      >
        <span>Totes</span>
        <span class={`text-[10px] ${!activeTag ? 'text-white/80' : 'text-[var(--text-muted)]/70'}`}>
          ({totalPosts})
        </span>
      </a>

      {tags.map((tag) => {
        const isActive = activeTag === tag.slug;
        return (
          <a
            href={`/blog/etiqueta/${tag.slug}`}
            title={tag.description || `Veure articles amb l'etiqueta #${tag.label}`}
            class={`inline-flex items-center gap-1.5 text-xs font-mono px-3 py-1.5 rounded-full border transition-all ${
              isActive
                ? 'bg-[var(--accent)] text-white border-[var(--accent)] font-semibold shadow-xs'
                : 'bg-[var(--card-bg)] text-[var(--text-muted)] border-[var(--border-color)] hover:border-[var(--accent)] hover:text-[var(--accent)]'
            }`}
          >
            <span>#{tag.label}</span>
            <span class={`text-[10px] ${isActive ? 'text-white/80' : 'text-[var(--text-muted)]/70'}`}>
              ({tag.count})
            </span>
          </a>
        );
      })}
    </div>
  </nav>
)}
