---
const navLinks = [
  { href: '/', label: 'Inici' },
  { href: '/relats', label: 'Llibres i relats' },
  { href: '/blog', label: 'Blog' },
  { href: '/sobre-scriptum', label: 'L\'Autor' },
  { href: '/contacte', label: 'Contacte' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[var(--bg-main)]/90 border-b border-[var(--border-color)] transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
    <!-- Logotip Scriptum -->
    <a href="/" class="notranslate group flex items-center gap-2.5 text-decoration-none">
      <span class="w-8 h-8 rounded-lg bg-[var(--accent)] text-white flex items-center justify-center font-display font-bold text-lg shadow-sm transition-transform group-hover:scale-105">
        S
      </span>
      <div class="flex flex-col">
        <span class="font-display font-bold text-xl tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
          Scriptum
        </span>
        <span class="text-[10px] tracking-widest uppercase font-sans text-[var(--text-muted)] -mt-1">
          Lletres & Cròniques
        </span>
      </div>
    </a>

    <!-- Navegació Desktop -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-sans font-medium">
      {navLinks.map((link) => {
        const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`transition-colors py-1 ${
              isActive
                ? 'text-[var(--accent)] font-semibold border-b-2 border-[var(--accent)]'
                : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Botons auxiliars: novetats, selector d'idioma i tema ràpid -->
    <div class="flex items-center gap-2">
      <!-- Botó de Novetats (només visible quan hi ha contingut nou des de la darrera visita) -->
      <button
        id="updates-btn"
        type="button"
        class="hidden items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-[var(--accent)] text-white text-[11px] font-mono font-semibold shadow-xs hover:opacity-90 transition-all cursor-pointer"
        title="Hi ha novetats des de la teva darrera visita"
        aria-label="Veure novetats"
      >
        <span>✦</span>
        <span class="hidden sm:inline">Novetats</span>
        <span id="updates-count" class="px-1.5 py-0.2 rounded-full bg-white/20 text-[10px]">0</span>
      </button>

      <!-- Selector d'idioma CA / ES / EN -->
      <div
        id="lang-selector"
        class="notranslate flex items-center border border-[var(--border-color)] rounded-lg overflow-hidden bg-[var(--card-bg)] text-[11px] font-mono"
        role="group"
        aria-label="Selector d'idioma"
      >
        <button
          type="button"
          data-lang="ca"
          class="lang-btn px-2 py-1.5 transition-colors cursor-pointer font-semibold bg-[var(--accent)] text-white"
          title="Català (idioma original)"
        >
          CA
        </button>
        <span class="w-[1px] h-4 bg-[var(--border-color)]"></span>
        <button
          type="button"
          data-lang="es"
          class="lang-btn px-2 py-1.5 transition-colors cursor-pointer text-[var(--text-muted)] hover:text-[var(--text-primary)]"
          title="Traducir al español"
        >
          ES
        </button>
        <span class="w-[1px] h-4 bg-[var(--border-color)]"></span>
        <button
          type="button"
          data-lang="en"
          class="lang-btn px-2 py-1.5 transition-colors cursor-pointer text-[var(--text-muted)] hover:text-[var(--text-primary)]"
          title="Translate to English"
        >
          EN
        </button>
      </div>

      <button
        id="theme-toggle-btn"
        type="button"
        class="p-2 rounded-lg border border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--card-bg)] text-xs font-sans transition-all cursor-pointer flex items-center gap-1.5"
        title="Canviar to de lectura (Paper, Sèpia, Nocturn)"
        aria-label="Canviar tema"
      >
        <span id="theme-icon">📜</span>
        <span id="theme-label" class="hidden sm:inline font-mono text-[11px]">Paper</span>
      </button>

      <!-- Botó Menú Mòbil -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg border border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-primary)]"
        aria-label="Obrir menú"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú Mòbil desplegable -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--border-color)] bg-[var(--card-bg)] px-4 py-3 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-2 text-sm font-sans font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)]"
      >
        {link.label}
      </a>
    ))}
  </div>
  <!-- Contenidor ocult de Google Translate -->
  <div id="google_translate_element" class="hidden" aria-hidden="true"></div>
</header>

<!-- Finestra flotant de Novetats des de la darrera visita -->
<div
  id="updates-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="updates-modal-title"
>
  <div class="max-w-lg w-full rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 sm:p-7 shadow-xl space-y-4">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-lg bg-[var(--accent)]/15 text-[var(--accent)] flex items-center justify-center text-base shrink-0">
          ✦
        </span>
        <div>
          <h3 id="updates-modal-title" class="font-display font-bold text-lg text-[var(--text-primary)] leading-tight">
            Novetats des de la teva darrera visita
          </h3>
          <p class="text-xs font-serif text-[var(--text-muted)]">
            S'han afegit nous textos a Scriptum des de l'últim cop que hi vas passar.
          </p>
        </div>
      </div>
    </div>

    <ul
      id="updates-list"
      class="max-h-72 overflow-y-auto divide-y divide-[var(--border-color)]/70 rounded-xl border border-[var(--border-color)] bg-[var(--bg-main)]"
    ></ul>

    <div class="pt-1 flex items-center justify-end gap-2.5 font-sans text-xs flex-wrap">
      <button
        id="updates-later-btn"
        type="button"
        class="px-4 py-2 rounded-xl border border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] transition-colors cursor-pointer"
      >
        Més tard
      </button>
      <button
        id="updates-mark-seen-btn"
        type="button"
        class="px-4 py-2 rounded-xl bg-[var(--accent)] text-white font-semibold hover:opacity-90 transition-opacity cursor-pointer"
      >
        ✓ Marcar tot com a vist
      </button>
    </div>
  </div>
</div>

<!-- Finestra flotant d'avís de traducció automàtica -->
<div
  id="translate-notice-modal"
  class="notranslate fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-xs p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="translate-notice-title"
>
  <div class="max-w-md w-full rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6 sm:p-7 shadow-xl space-y-4">
    <div class="flex items-center gap-2.5">
      <span class="w-8 h-8 rounded-lg bg-[var(--accent)]/15 text-[var(--accent)] flex items-center justify-center text-base">
        🌐
      </span>
      <h3 id="translate-notice-title" class="font-display font-bold text-lg text-[var(--text-primary)]">
        Aviso de traducción automática
      </h3>
    </div>

    <p id="translate-notice-body" class="font-serif text-sm text-[var(--text-primary)] leading-relaxed"></p>

    <div class="pt-2 flex items-center justify-end gap-2.5 font-sans text-xs">
      <button
        id="translate-notice-cancel"
        type="button"
        class="px-4 py-2 rounded-xl border border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] transition-colors cursor-pointer"
      >
        Cancelar
      </button>
      <button
        id="translate-notice-confirm"
        type="button"
        class="px-4 py-2 rounded-xl bg-[var(--accent)] text-white font-semibold hover:opacity-90 transition-opacity cursor-pointer"
      >
        Entendido
      </button>
    </div>
  </div>
</div>

<script>
  // Gestor del botó de menú mòbil
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Cicle de temes: paper -> sepia -> nocturn -> paper
  const themes = [
    { id: 'paper', icon: '📜', label: 'Paper' },
    { id: 'sepia', icon: '☕', label: 'Sèpia' },
    { id: 'nocturn', icon: '🌙', label: 'Nocturn' }
  ];

  function applyTheme(themeId) {
    if (themeId === 'paper') {
      document.body.removeAttribute('data-theme');
    } else {
      document.body.setAttribute('data-theme', themeId);
    }
    localStorage.setItem('scriptum-theme', themeId);
    
    const cur = themes.find(t => t.id === themeId) || themes[0];
    const iconEl = document.getElementById('theme-icon');
    const labelEl = document.getElementById('theme-label');
    if (iconEl) iconEl.textContent = cur.icon;
    if (labelEl) labelEl.textContent = cur.label;
  }

  // Inicialitzar tema
  const saved = localStorage.getItem('scriptum-theme') || 'paper';
  applyTheme(saved);

  const toggleBtn = document.getElementById('theme-toggle-btn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const current = localStorage.getItem('scriptum-theme') || 'paper';
      const idx = themes.findIndex(t => t.id === current);
      const next = themes[(idx + 1) % themes.length].id;
      applyTheme(next);
    });
  }

  // --- Traducció automàtica opcional (CA / ES / EN) amb Google Translate ---
  const TRANSLATE_MESSAGES: Record<'es' | 'en', { title: string; body: string; confirm: string; cancel: string }> = {
    es: {
      title: 'Traducción automática al español',
      body: 'El contenido de los artículos y relatos será traducido al español de manera automática. Es posible que la traducción no exprese exactamente la intención o el significado escritos en el idioma original.',
      confirm: 'Continuar en español',
      cancel: 'Mantener en catalán',
    },
    en: {
      title: 'Automatic English translation',
      body: 'The content of the articles and stories will be automatically translated into English. The translation may not precisely convey the intent or meaning expressed in the original language.',
      confirm: 'Continue in English',
      cancel: 'Keep in Catalan',
    },
  };

  function getActiveLang(): 'ca' | 'es' | 'en' {
    const match = document.cookie.match(/(?:^|;\s*)googtrans=\/ca\/(es|en)(?:;|$)/);
    if (match && (match[1] === 'es' || match[1] === 'en')) {
      return match[1];
    }
    return 'ca';
  }

  function setGoogTransCookie(lang: 'ca' | 'es' | 'en') {
    const hostname = window.location.hostname;
    if (lang === 'ca') {
      document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${hostname};`;
      document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.${hostname};`;
    } else {
      const value = `/ca/${lang}`;
      document.cookie = `googtrans=${value}; path=/;`;
      if (hostname.includes('.')) {
        document.cookie = `googtrans=${value}; path=/; domain=${hostname};`;
      }
    }
  }

  function updateLangButtons(active: 'ca' | 'es' | 'en') {
    document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach((btn) => {
      const isCurrent = btn.dataset.lang === active;
      if (isCurrent) {
        btn.classList.add('bg-[var(--accent)]', 'text-white', 'font-semibold');
        btn.classList.remove('text-[var(--text-muted)]');
      } else {
        btn.classList.remove('bg-[var(--accent)]', 'text-white', 'font-semibold');
        btn.classList.add('text-[var(--text-muted)]');
      }
    });
  }

  let gtLoaded = false;
  function loadGoogleTranslate() {
    if (gtLoaded) return;
    gtLoaded = true;

    (window as any).googleTranslateElementInit = function () {
      if ((window as any).google?.translate?.TranslateElement) {
        new (window as any).google.translate.TranslateElement(
          {
            pageLanguage: 'ca',
            includedLanguages: 'es,en',
            autoDisplay: false,
          },
          'google_translate_element'
        );
      }
    };

    const script = document.createElement('script');
    script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    script.async = true;
    document.body.appendChild(script);
  }

  /**
   * Evita que Google Translate tradueixi articles o relats quan ja estan escrits
   * originalment en el mateix idioma seleccionat (p. ex. original `es` amb selector `ES`).
   */
  function syncOriginalLangProtection(targetLang: 'ca' | 'es' | 'en') {
    document.querySelectorAll<HTMLElement>('[data-original-lang]').forEach((el) => {
      const orig = (el.dataset.originalLang || '').toLowerCase();
      if (orig && orig === targetLang) {
        el.classList.add('notranslate');
      } else {
        el.classList.remove('notranslate');
      }
    });
  }

  function applyLanguage(lang: 'ca' | 'es' | 'en') {
    setGoogTransCookie(lang);
    updateLangButtons(lang);
    syncOriginalLangProtection(lang);

    if (lang === 'ca') {
      window.location.reload();
      return;
    }

    const combo = document.querySelector<HTMLSelectElement>('.goog-te-combo');
    if (combo) {
      combo.value = lang;
      combo.dispatchEvent(new Event('change'));
    } else {
      loadGoogleTranslate();
      // Si la cookie s'acaba d'establir abans de carregar el script, recarreguem si en 900ms no ha traduït
      setTimeout(() => {
        const readyCombo = document.querySelector<HTMLSelectElement>('.goog-te-combo');
        if (readyCombo) {
          readyCombo.value = lang;
          readyCombo.dispatchEvent(new Event('change'));
        } else {
          window.location.reload();
        }
      }, 900);
    }
  }

  // Inicialització d'idioma en carregar la pàgina
  const initialLang = getActiveLang();
  updateLangButtons(initialLang);
  syncOriginalLangProtection(initialLang);
  if (initialLang !== 'ca') {
    loadGoogleTranslate();
  }

  // Gestió del modal d'avís
  const noticeModal = document.getElementById('translate-notice-modal');
  const noticeTitle = document.getElementById('translate-notice-title');
  const noticeBody = document.getElementById('translate-notice-body');
  const noticeConfirm = document.getElementById('translate-notice-confirm');
  const noticeCancel = document.getElementById('translate-notice-cancel');

  let pendingLang: 'es' | 'en' | null = null;

  function openNoticeModal(lang: 'es' | 'en') {
    const msg = TRANSLATE_MESSAGES[lang];
    pendingLang = lang;
    if (noticeTitle) noticeTitle.textContent = msg.title;
    if (noticeBody) noticeBody.textContent = msg.body;
    if (noticeConfirm) noticeConfirm.textContent = msg.confirm;
    if (noticeCancel) noticeCancel.textContent = msg.cancel;
    noticeModal?.classList.remove('hidden');
    noticeModal?.classList.add('flex');
  }

  function closeNoticeModal() {
    pendingLang = null;
    noticeModal?.classList.add('hidden');
    noticeModal?.classList.remove('flex');
  }

  noticeConfirm?.addEventListener('click', () => {
    if (!pendingLang) return;
    const chosen = pendingLang;
    closeNoticeModal();
    applyLanguage(chosen);
  });

  noticeCancel?.addEventListener('click', closeNoticeModal);

  noticeModal?.addEventListener('click', (e) => {
    if (e.target === noticeModal) closeNoticeModal();
  });

  document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetLang = btn.dataset.lang as 'ca' | 'es' | 'en' | undefined;
      if (!targetLang || targetLang === getActiveLang()) return;

      if (targetLang === 'ca') {
        applyLanguage('ca');
      } else {
        openNoticeModal(targetLang);
      }
    });
  });

  // --- Detector de Novetats des de la darrera visita (sense BBDD, via localStorage) ---
  interface CatalogPost { id: string; title: string; url: string; }
  interface CatalogBook { id: string; title: string; url: string; }
  interface CatalogChapter { id: string; bookId: string; bookTitle: string; label: string; title: string; url: string; }
  interface CatalogPayload {
    posts: CatalogPost[];
    books: CatalogBook[];
    chapters: CatalogChapter[];
  }
  interface UpdateEntry {
    id: string;
    kind: string;
    title: string;
    subtitle?: string;
    url: string;
    relatedIds: string[];
  }

  const SEEN_CATALOG_KEY = 'scriptum-seen-catalog';
  const MODAL_DISMISSED_SESSION_KEY = 'scriptum-updates-dismissed';

  const updatesBtn = document.getElementById('updates-btn');
  const updatesCountEl = document.getElementById('updates-count');
  const updatesModal = document.getElementById('updates-modal');
  const updatesListEl = document.getElementById('updates-list');
  const updatesLaterBtn = document.getElementById('updates-later-btn');
  const updatesMarkSeenBtn = document.getElementById('updates-mark-seen-btn');

  function getAllCatalogIds(catalog: CatalogPayload): string[] {
    return [
      ...catalog.posts.map((p) => p.id),
      ...catalog.books.map((b) => b.id),
      ...catalog.chapters.map((c) => c.id),
    ];
  }

  function loadSeenIds(): string[] | null {
    try {
      const raw = localStorage.getItem(SEEN_CATALOG_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : null;
    } catch {
      return null;
    }
  }

  function saveSeenIds(ids: string[]) {
    try {
      localStorage.setItem(SEEN_CATALOG_KEY, JSON.stringify(Array.from(new Set(ids))));
    } catch {}
  }

  function openUpdatesModal() {
    updatesModal?.classList.remove('hidden');
    updatesModal?.classList.add('flex');
  }

  function closeUpdatesModal() {
    updatesModal?.classList.add('hidden');
    updatesModal?.classList.remove('flex');
  }

  async function initUpdatesChecker() {
    try {
      const res = await fetch('/novetats.json', { cache: 'no-cache' });
      if (!res.ok) return;
      const catalog: CatalogPayload = await res.json();
      const allIds = getAllCatalogIds(catalog);
      const params = new URLSearchParams(window.location.search);
      const isTestMode = params.get('prova-novetats') === '1';

      let seenIds = loadSeenIds();

      // Primera visita: desem silenciosament el catàleg actual sense molestar
      if (!seenIds && !isTestMode) {
        saveSeenIds(allIds);
        return;
      }

      // Mode de prova (?prova-novetats=1): simulem que falten els 2 últims articles i 1 llibre
      if (isTestMode) {
        const simulatedMissing = new Set<string>([
          ...catalog.posts.slice(0, 2).map((p) => p.id),
          ...catalog.books.slice(0, 1).map((b) => b.id),
        ]);
        seenIds = allIds.filter((id) => !simulatedMissing.has(id));
      }

      const seenSet = new Set(seenIds || []);

      // Si el lector ja està visitant ara mateix una pàgina nova, la marquem com a vista
      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      let changedCurrent = false;
      for (const p of catalog.posts) {
        if (p.url === currentPath && !seenSet.has(p.id)) {
          seenSet.add(p.id);
          changedCurrent = true;
        }
      }
      for (const b of catalog.books) {
        if (b.url === currentPath && !seenSet.has(b.id)) {
          seenSet.add(b.id);
          catalog.chapters.filter((c) => c.bookId === b.id).forEach((c) => seenSet.add(c.id));
          changedCurrent = true;
        }
      }
      for (const c of catalog.chapters) {
        if (c.url === currentPath && !seenSet.has(c.id)) {
          seenSet.add(c.id);
          changedCurrent = true;
        }
      }
      if (changedCurrent && !isTestMode) {
        saveSeenIds(Array.from(seenSet));
      }

      // Calculem novetats reals agrupant llibres nous en una sola fila
      const newBookIds = new Set<string>();
      const updates: UpdateEntry[] = [];

      for (const book of catalog.books) {
        if (!seenSet.has(book.id)) {
          newBookIds.add(book.id);
          const bookChapterIds = catalog.chapters
            .filter((c) => c.bookId === book.id)
            .map((c) => c.id);
          updates.push({
            id: book.id,
            kind: 'Nou llibre',
            title: book.title,
            url: book.url,
            relatedIds: [book.id, ...bookChapterIds],
          });
        }
      }

      for (const chap of catalog.chapters) {
        if (!newBookIds.has(chap.bookId) && !seenSet.has(chap.id)) {
          updates.push({
            id: chap.id,
            kind: chap.bookTitle,
            title: chap.title,
            subtitle: chap.label,
            url: chap.url,
            relatedIds: [chap.id],
          });
        }
      }

      for (const post of catalog.posts) {
        if (!seenSet.has(post.id)) {
          updates.push({
            id: post.id,
            kind: 'Blog',
            title: post.title,
            url: post.url,
            relatedIds: [post.id],
          });
        }
      }

      if (updates.length === 0) return;

      // Mostrem el botó a la barra superior
      if (updatesBtn && updatesCountEl) {
        updatesCountEl.textContent = String(updates.length);
        updatesBtn.classList.remove('hidden');
        updatesBtn.classList.add('inline-flex');
      }

      // Omplim la llista del modal
      if (updatesListEl) {
        updatesListEl.innerHTML = '';
        updates.forEach((item) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = item.url;
          a.className =
            'flex items-center justify-between gap-3 px-4 py-3 hover:bg-[var(--card-bg)] transition-colors group';

          const left = document.createElement('div');
          left.className = 'min-w-0';

          const meta = document.createElement('span');
          meta.className = 'block text-[10px] font-mono uppercase tracking-wider text-[var(--accent)] font-semibold';
          meta.textContent = item.subtitle ? `${item.kind} · ${item.subtitle}` : item.kind;

          const titleSpan = document.createElement('span');
          titleSpan.className =
            'block font-display font-semibold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors truncate';
          titleSpan.textContent = item.title;

          left.appendChild(meta);
          left.appendChild(titleSpan);

          const arrow = document.createElement('span');
          arrow.className = 'text-xs font-sans font-semibold text-[var(--accent)] shrink-0';
          arrow.textContent = 'Llegir →';

          a.appendChild(left);
          a.appendChild(arrow);

          a.addEventListener('click', () => {
            if (!isTestMode) {
              item.relatedIds.forEach((rid) => seenSet.add(rid));
              saveSeenIds(Array.from(seenSet));
            }
          });

          li.appendChild(a);
          updatesListEl.appendChild(li);
        });
      }

      updatesBtn?.addEventListener('click', openUpdatesModal);

      updatesLaterBtn?.addEventListener('click', () => {
        try {
          sessionStorage.setItem(MODAL_DISMISSED_SESSION_KEY, '1');
        } catch {}
        closeUpdatesModal();
      });

      updatesMarkSeenBtn?.addEventListener('click', () => {
        if (!isTestMode) {
          saveSeenIds(allIds);
        }
        closeUpdatesModal();
        updatesBtn?.classList.add('hidden');
        updatesBtn?.classList.remove('inline-flex');
      });

      updatesModal?.addEventListener('click', (e) => {
        if (e.target === updatesModal) {
          try {
            sessionStorage.setItem(MODAL_DISMISSED_SESSION_KEY, '1');
          } catch {}
          closeUpdatesModal();
        }
      });

      // Obrim automàticament la finestra emergent un sol cop per sessió (o sempre en mode prova)
      const alreadyDismissed = sessionStorage.getItem(MODAL_DISMISSED_SESSION_KEY) === '1';
      if (isTestMode || !alreadyDismissed) {
        openUpdatesModal();
      }
    } catch {
      // Si falla la càrrega del catàleg, no interrompem la lectura
    }
  }

  initUpdatesChecker();
</script>

