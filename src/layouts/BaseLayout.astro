---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Scriptum — Espai literari, relats per capítols i pensament',
  description = 'Scriptum és un refugi per a la lectura pausada, obres literàries organitzades per capítols i articles de reflexió.',
  image = '/images/og-scriptum.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />

    <!-- Script de prevenció de parpelleig de tema -->
    <script is:inline>
      const savedTheme = localStorage.getItem('scriptum-theme') || 'paper';
      if (savedTheme !== 'paper') {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Decoració automàtica de notes al peu i enllaços externs (YouTube / Llibre) a tot el web -->
    <script>
      const footnoteHeading = document.getElementById('footnote-label');
      if (footnoteHeading) {
        footnoteHeading.textContent = 'Notes i referències';
        footnoteHeading.classList.remove('sr-only');
      }

      const BACKREF_SVG =
        '<svg class="ext-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="10 9 15 4 20 9"/><path d="M4 20h7a4 4 0 0 0 4-4V4"/></svg>';

      document
        .querySelectorAll<HTMLAnchorElement>('.prose-literaria a[data-footnote-backref], .prose-blank-page a[data-footnote-backref]')
        .forEach((backref) => {
          backref.innerHTML = BACKREF_SVG;
          backref.title = 'Tornar';
          backref.setAttribute('aria-label', 'Tornar');
        });

      const YOUTUBE_SVG =
        '<svg class="ext-link-icon ext-link-youtube" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#DC2626" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8z"/><polygon fill="#FFFFFF" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>';

      const BOOK_SVG =
        '<svg class="ext-link-icon ext-link-book" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>';

      document
        .querySelectorAll<HTMLAnchorElement>('.prose-literaria a[href], .prose-blank-page a[href]')
        .forEach((link) => {
          if (link.dataset.iconDecorated === '1') return;
          const href = link.getAttribute('href') || '';
          if (!href || href.startsWith('#') || href.startsWith('/')) return;

          let url: URL;
          try {
            url = new URL(href, window.location.origin);
          } catch {
            return;
          }

          if (url.origin === window.location.origin) return;

          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.dataset.iconDecorated = '1';

          const host = url.hostname.toLowerCase();
          const isYouTube = host.includes('youtube.com') || host.includes('youtu.be');
          const inFootnotes = Boolean(link.closest('.footnotes'));
          const rawText = (link.textContent || '').trim();
          const isRawUrlText = /^(https?:\/\/|www\.)/i.test(rawText);

          if (isYouTube) {
            if (isRawUrlText) {
              link.textContent = '';
              link.classList.add('ext-link-icon-only');
              link.title = `Veure vídeo a YouTube (${href})`;
              link.setAttribute('aria-label', 'Veure vídeo a YouTube');
            } else {
              link.classList.add('ext-link-styled');
            }
            link.insertAdjacentHTML('afterbegin', YOUTUBE_SVG);
          } else if (inFootnotes) {
            if (isRawUrlText) {
              link.textContent = '';
              link.classList.add('ext-link-icon-only');
              link.title = `Obrir lectura externa (${href})`;
              link.setAttribute('aria-label', 'Obrir lectura externa');
            } else {
              link.classList.add('ext-link-styled');
            }
            link.insertAdjacentHTML('afterbegin', BOOK_SVG);
          }
        });
    </script>
  </body>
</html>

