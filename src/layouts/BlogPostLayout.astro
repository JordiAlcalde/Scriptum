---
import BaseLayout from './BaseLayout.astro';
import ShareButton from '../components/ShareButton.astro';
import { slugifyTag } from '../utils/tags';
import { getLangBadge } from '../utils/lang';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface NavPost {
  title: string;
  slug: string;
}

interface Props {
  slug?: string;
  title: string;
  description: string;
  pubDate: Date;
  author?: string;
  tags?: string[];
  headings?: HeadingItem[];
  readingTime?: string;
  idioma?: string;
  esborrany?: boolean;
  prevPost?: NavPost | null;
  nextPost?: NavPost | null;
}

const {
  slug = '',
  title,
  description,
  pubDate,
  author = 'Scriptum',
  tags = [],
  headings = [],
  readingTime = '4 min',
  idioma,
  esborrany = false,
  prevPost = null,
  nextPost = null,
} = Astro.props;

const sectionHeadings = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const langBadge = getLangBadge(idioma);

const formattedDate = new Intl.DateTimeFormat('ca-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(pubDate);
---

<BaseLayout title={`${title} | Blog Scriptum`} description={description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="mb-6">
      <a href="/blog" class="text-xs font-sans font-semibold text-[var(--accent)] hover:underline inline-flex items-center gap-1">
        <span>← Tornar a tots els articles</span>
      </a>
    </div>

    <header class="space-y-4 pb-8 border-b border-[var(--border-color)] mb-10">
      <div class="flex items-center gap-3 text-xs font-mono text-[var(--text-muted)] flex-wrap">
        {esborrany && (
          <span class="px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-700 border border-amber-600/30 font-semibold">
            📝 ESBORRANY (només visible en local)
          </span>
        )}
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>Per {author}</span>
        <span>·</span>
        <span>⏱️ {readingTime} de lectura</span>
        {langBadge && (
          <span
            title={langBadge.title}
            class="notranslate text-[10px] font-mono font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-[var(--accent)] text-white shadow-2xs"
          >
            {langBadge.code}
          </span>
        )}
      </div>

      <div data-original-lang={langBadge?.lang} class="space-y-4">
        <h1 class="font-display font-bold text-3xl sm:text-4xl text-[var(--text-primary)] leading-tight">
          {title}
        </h1>

        <p class="text-base text-[var(--text-muted)] font-serif italic leading-relaxed">
          {description}
        </p>
      </div>

      {tags.length > 0 && (
        <div class="flex items-center gap-2 pt-2 flex-wrap">
          {tags.map((tag) => (
            <a
              href={`/blog/etiqueta/${slugifyTag(tag)}`}
              class="text-xs font-mono px-2.5 py-0.5 rounded-md bg-[var(--border-color)]/60 text-[var(--text-muted)] hover:bg-[var(--accent)]/15 hover:text-[var(--accent)] transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    {sectionHeadings.length >= 2 && (
      <nav
        aria-label="Índex de seccions de l'article"
        class="mb-10 p-5 sm:p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-3"
      >
        <span class="block text-[11px] font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">
          En aquest article
        </span>
        <ol class="space-y-1.5 text-sm font-serif list-none pl-0">
          {sectionHeadings.map((h, idx) => (
            <li>
              <a
                href={`#${h.slug}`}
                class="group inline-flex items-baseline gap-2.5 text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors"
              >
                <span class="text-xs font-mono text-[var(--text-muted)] group-hover:text-[var(--accent)]">
                  {String(idx + 1).padStart(2, '0')}.
                </span>
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div data-original-lang={langBadge?.lang} class="prose-literaria">
      <slot />
    </div>

    <div class="scene-break my-12 text-center">
      <span>❦</span>
    </div>

    {slug && (
      <div
        id="blog-read-tracker"
        data-post-slug={slug}
        class="mb-8 flex flex-wrap items-center justify-between gap-3 text-xs font-sans"
      >
        <ShareButton
          title={`${title} | Scriptum`}
          text={description}
          label="Compartir article"
        />

        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--card-bg)] text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] font-medium transition-all"
        >
          <span>← Tots els articles</span>
        </a>

        <button
          id="btn-toggle-post-read"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--card-bg)] text-[var(--text-muted)] hover:border-[var(--accent)] hover:text-[var(--accent)] font-medium transition-all cursor-pointer"
        >
          <span id="post-read-icon">○</span>
          <span id="post-read-text">Marcar com a llegit</span>
        </button>
      </div>
    )}

    {(prevPost || nextPost) && (
      <nav
        aria-label="Navegació entre articles"
        class="mb-8 pt-6 border-t border-[var(--border-color)] grid grid-cols-1 sm:grid-cols-2 gap-4 font-sans text-xs"
      >
        {prevPost ? (
          <a
            href={`/blog/${prevPost.slug}`}
            class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent)] transition-all flex flex-col gap-1 text-left group"
          >
            <span class="text-[10px] uppercase font-mono text-[var(--text-muted)]">
              ← Article anterior
            </span>
            <span class="font-display font-semibold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
              {prevPost.title}
            </span>
          </a>
        ) : (
          <div class="hidden sm:block"></div>
        )}

        {nextPost && (
          <a
            href={`/blog/${nextPost.slug}`}
            class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent)] transition-all flex flex-col gap-1 text-right group"
          >
            <span class="text-[10px] uppercase font-mono text-[var(--text-muted)]">
              Article següent →
            </span>
            <span class="font-display font-semibold text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
              {nextPost.title}
            </span>
          </a>
        )}
      </nav>
    )}

    <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] flex flex-col sm:flex-row items-center justify-between gap-4 font-sans text-xs">
      <div>
        <h4 class="font-display font-bold text-sm text-[var(--text-primary)]">T'ha agradat aquesta lectura?</h4>
        <p class="text-[var(--text-muted)]">Descobreix més articles i relats a la biblioteca de Scriptum.</p>
      </div>
      <a href="/relats" class="px-4 py-2 rounded-xl bg-[var(--accent)] text-white font-semibold shrink-0 hover:opacity-90 transition-opacity">
        Explorar relats
      </a>
    </div>
  </article>
</BaseLayout>

<script>
  import { isBlogPostRead, setBlogPostRead } from '../utils/readingProgress';

  const tracker = document.getElementById('blog-read-tracker');
  if (tracker) {
    const postSlug = tracker.dataset.postSlug || '';
    if (postSlug) {
      const toggleBtn = document.getElementById('btn-toggle-post-read');
      const iconEl = document.getElementById('post-read-icon');
      const textEl = document.getElementById('post-read-text');
      let manuallyUnmarked = false;

      function renderState(isRead: boolean) {
        if (!toggleBtn || !iconEl || !textEl) return;
        if (isRead) {
          iconEl.textContent = '✓';
          textEl.textContent = 'Article llegit';
          toggleBtn.classList.add('border-emerald-600/40', 'text-emerald-700', 'bg-emerald-500/10');
          toggleBtn.classList.remove('border-[var(--border-color)]', 'text-[var(--text-muted)]', 'bg-[var(--card-bg)]');
        } else {
          iconEl.textContent = '○';
          textEl.textContent = 'Marcar com a llegit';
          toggleBtn.classList.remove('border-emerald-600/40', 'text-emerald-700', 'bg-emerald-500/10');
          toggleBtn.classList.add('border-[var(--border-color)]', 'text-[var(--text-muted)]', 'bg-[var(--card-bg)]');
        }
      }

      renderState(isBlogPostRead(postSlug));

      toggleBtn?.addEventListener('click', () => {
        const next = !isBlogPostRead(postSlug);
        manuallyUnmarked = !next;
        setBlogPostRead(postSlug, next);
        renderState(next);
      });

      const checkScroll = () => {
        if (manuallyUnmarked || isBlogPostRead(postSlug)) return;
        const scrollPos = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
        if (scrollPos >= 0.85) {
          setBlogPostRead(postSlug, true);
          renderState(true);
        }
      };

      window.addEventListener('scroll', checkScroll, { passive: true });
    }
  }
</script>

